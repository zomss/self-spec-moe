{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-spec.local/phase97/p4_b0_gpu_contention_probe_authorization_v2.schema.json",
  "title": "Phase 97 non-ephemeral GPU contention-probe authorization V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "date",
    "status",
    "consumed_v11",
    "relocation_probe",
    "source_artifacts",
    "run_contract",
    "decision",
    "claims",
    "authorizations",
    "next_artifact"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": {
      "const": "p4-b0-gpu-contention-probe-authorization-v2"
    },
    "date": { "type": "string", "format": "date" },
    "status": {
      "const": "authorized_gpu0_gpu1_non_ephemeral_contention_probe_only"
    },
    "consumed_v11": { "$ref": "#/$defs/consumed_v11" },
    "relocation_probe": { "$ref": "#/$defs/relocation_probe" },
    "source_artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/source_ref" }
    },
    "run_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scored",
        "output_dir",
        "source_value_screen",
        "engine",
        "workload",
        "gpu_assignments",
        "runs",
        "schedule",
        "port_range_size",
        "thresholds",
        "attempt_policy"
      ],
      "properties": {
        "scope": {
          "const": "source_bound_non_scored_serial_vs_concurrent_aa_probe_only"
        },
        "scored": { "const": false },
        "output_dir": {
          "const": "research/97_composition_runtime/data/p4/run_b0_gpu_contention_probe_v2"
        },
        "source_value_screen": { "type": "object" },
        "engine": { "type": "object" },
        "workload": {
          "type": "object",
          "properties": {
            "action_id": { "const": "target-matching-k4" },
            "regime_id": { "const": "R8" },
            "rounds": { "const": [1, 2, 3, 4] },
            "batch": { "const": 16 },
            "max_output_tokens": { "const": 2048 }
          },
          "required": [
            "source_boot_id",
            "action_id",
            "boot_block_id",
            "action_position",
            "regime_id",
            "content_seed",
            "rounds",
            "prompts_per_round",
            "batch",
            "max_output_tokens",
            "measurement_currency"
          ]
        },
        "gpu_assignments": {
          "type": "object",
          "required": ["gpu0", "gpu1"]
        },
        "runs": {
          "const": {
            "serial-gpu0": {
              "condition": "serial",
              "gpu_id": "gpu0",
              "port_start": 20000
            },
            "serial-gpu1": {
              "condition": "serial",
              "gpu_id": "gpu1",
              "port_start": 20100
            },
            "concurrent-gpu0": {
              "condition": "concurrent",
              "gpu_id": "gpu0",
              "port_start": 20200
            },
            "concurrent-gpu1": {
              "condition": "concurrent",
              "gpu_id": "gpu1",
              "port_start": 20300
            }
          }
        },
        "schedule": {
          "const": [
            ["serial-gpu0"],
            ["serial-gpu1"],
            ["concurrent-gpu0", "concurrent-gpu1"]
          ]
        },
        "port_range_size": { "const": 100 },
        "thresholds": { "type": "object" },
        "attempt_policy": { "type": "object" }
      }
    },
    "decision": { "type": "object" },
    "claims": { "type": "object" },
    "authorizations": { "type": "object" },
    "next_artifact": { "type": "object" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "consumed_v11": {
      "type": "object",
      "required": [
        "authorization",
        "capture_manifest",
        "interruption",
        "disposition",
        "complete_capture_count",
        "empty_placeholder_count",
        "score_emitted",
        "reuse_allowed"
      ],
      "properties": {
        "authorization": { "$ref": "#/$defs/artifact_ref" },
        "capture_manifest": { "$ref": "#/$defs/artifact_ref" },
        "interruption": { "$ref": "#/$defs/artifact_ref" },
        "disposition": { "const": "consumed_external_resource_reassignment" },
        "complete_capture_count": { "const": 48 },
        "empty_placeholder_count": { "const": 1 },
        "score_emitted": { "const": false },
        "reuse_allowed": { "const": false }
      },
      "additionalProperties": false
    },
    "relocation_probe": {
      "type": "object",
      "required": [
        "authorization",
        "result",
        "status",
        "scored",
        "gpu0_exact_r8_passed",
        "gpu1_r5cot_to_r8_passed",
        "shared_kv_floor_passed_on_both",
        "performance_claim_allowed"
      ],
      "properties": {
        "authorization": { "$ref": "#/$defs/artifact_ref" },
        "result": { "$ref": "#/$defs/artifact_ref" },
        "status": { "const": "pass" },
        "scored": { "const": false },
        "gpu0_exact_r8_passed": { "const": true },
        "gpu1_r5cot_to_r8_passed": { "const": true },
        "shared_kv_floor_passed_on_both": { "const": true },
        "performance_claim_allowed": { "const": false }
      },
      "additionalProperties": false
    }
  }
}
