{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-spec.local/phase97/action.schema.json",
  "title": "Phase 97 shared-KV action registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "boot_class_id",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "boot_class_id": {
      "$ref": "#/$defs/identifier"
    },
    "actions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/off_action"
          },
          {
            "$ref": "#/$defs/speculative_action"
          }
        ]
      },
      "contains": {
        "$ref": "#/$defs/off_action"
      },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "allOf": [
    {
      "properties": {
        "actions": {
          "contains": {
            "$ref": "#/$defs/speculative_action"
          },
          "minContains": 1
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "predecessors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "window": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "value",
            "cost_grade"
          ],
          "properties": {
            "mode": {
              "const": "off"
            },
            "value": {
              "const": 0
            },
            "cost_grade": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "value",
            "cost_grade"
          ],
          "properties": {
            "mode": {
              "const": "masked"
            },
            "value": {
              "type": "integer",
              "minimum": 1
            },
            "cost_grade": {
              "const": "acceptance_only"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "value",
            "cost_grade"
          ],
          "properties": {
            "mode": {
              "const": "cost_true"
            },
            "value": {
              "type": "integer",
              "minimum": 1
            },
            "cost_grade": {
              "const": "cost_true"
            }
          }
        }
      ]
    },
    "graph_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_id",
        "grade",
        "realization",
        "query_width"
      ],
      "properties": {
        "graph_id": {
          "$ref": "#/$defs/identifier"
        },
        "grade": {
          "enum": [
            "eager",
            "piecewise",
            "full"
          ]
        },
        "realization": {
          "$ref": "#/$defs/identifier"
        },
        "query_width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "off_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "kind",
        "target_graph_descriptor",
        "legal_switch_predecessors",
        "measured_transition_cost_us"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "off"
        },
        "target_graph_descriptor": {
          "$ref": "#/$defs/graph_descriptor"
        },
        "legal_switch_predecessors": {
          "$ref": "#/$defs/predecessors"
        },
        "measured_transition_cost_us": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "speculative_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "kind",
        "draft_weight_path_id",
        "realization",
        "window",
        "skip_set",
        "k",
        "target_graph_descriptor",
        "draft_graph_descriptor",
        "requires_current_draft_weight",
        "legal_switch_predecessors",
        "measured_transition_cost_us"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "speculative"
        },
        "draft_weight_path_id": {
          "$ref": "#/$defs/identifier"
        },
        "realization": {
          "$ref": "#/$defs/identifier"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "skip_set": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "k": {
          "type": "integer",
          "minimum": 1
        },
        "target_graph_descriptor": {
          "$ref": "#/$defs/graph_descriptor"
        },
        "draft_graph_descriptor": {
          "$ref": "#/$defs/graph_descriptor"
        },
        "requires_current_draft_weight": {
          "type": "boolean"
        },
        "legal_switch_predecessors": {
          "$ref": "#/$defs/predecessors"
        },
        "measured_transition_cost_us": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
