{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-spec.local/phase97/p4_b0_adapted_round.schema.json",
  "title": "Phase 97 adapted B0 scoreable round",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "round_contract_id",
    "adapter_contract_id",
    "capture_id",
    "complete",
    "score_eligible",
    "matrix",
    "match",
    "proofs",
    "source",
    "counters",
    "timing",
    "estimands"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "round_contract_id": {
      "const": "p4-b0-adapted-round-v1"
    },
    "adapter_contract_id": {
      "const": "p4-b0-same-event-adapter-v1"
    },
    "capture_id": {
      "$ref": "#/$defs/identifier"
    },
    "complete": {
      "const": true
    },
    "score_eligible": {
      "const": true
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boot_block_id",
        "boot_id",
        "action_id",
        "action_position",
        "action_realization",
        "regime_id",
        "content_seed",
        "round_index"
      ],
      "properties": {
        "boot_block_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "boot_id": {
          "$ref": "#/$defs/identifier"
        },
        "action_id": {
          "$ref": "#/$defs/action_id"
        },
        "action_position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "action_realization": {
          "enum": [
            "live-b0-forced-off",
            "live-b0-target-matching-k4",
            "boot-static-mask-equivalent-surrogate"
          ]
        },
        "regime_id": {
          "enum": [
            "R4",
            "R5",
            "R5cot",
            "R8",
            "R1",
            "R6"
          ]
        },
        "content_seed": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "round_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preregistration_id",
        "prompt_manifest_id",
        "prompt_manifest_sha256",
        "prompt_bundle_sha256",
        "prompt_record_ids_sha256",
        "prompt_count",
        "generation_seed",
        "batch",
        "max_output_tokens",
        "temperature",
        "ignore_eos",
        "requested_output_tokens",
        "stable_config_sha256"
      ],
      "properties": {
        "preregistration_id": {
          "const": "p4-b0-off-k4-w512-value-screen-v1"
        },
        "prompt_manifest_id": {
          "const": "p4-b0-six-regime-prompts-v1"
        },
        "prompt_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_record_ids_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_count": {
          "const": 32
        },
        "generation_seed": {
          "const": 0
        },
        "batch": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "ignore_eos": {
          "const": true
        },
        "requested_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "stable_config_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "proofs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shared_kv_binding_id",
        "shared_kv_alias_proven",
        "true_slot_mapping_id",
        "true_slot_identity_proven"
      ],
      "properties": {
        "shared_kv_binding_id": {
          "$ref": "#/$defs/identifier"
        },
        "shared_kv_alias_proven": {
          "const": true
        },
        "true_slot_mapping_id": {
          "$ref": "#/$defs/identifier"
        },
        "true_slot_identity_proven": {
          "const": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_count",
        "rejected_event_count",
        "event_ids_sha256",
        "first_engine_step_index",
        "last_engine_step_index"
      ],
      "properties": {
        "event_count": {
          "type": "integer",
          "minimum": 1
        },
        "rejected_event_count": {
          "const": 0
        },
        "event_ids_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "first_engine_step_index": {
          "type": "integer",
          "minimum": 0
        },
        "last_engine_step_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "H_target_steps",
        "D_armed",
        "A_accepted",
        "C_clipped",
        "E_committed",
        "U_unarmed",
        "closure_holds",
        "draft_subset_holds",
        "equal_work_holds"
      ],
      "properties": {
        "H_target_steps": {
          "type": "integer",
          "minimum": 1
        },
        "D_armed": {
          "type": "integer",
          "minimum": 0
        },
        "A_accepted": {
          "type": "integer",
          "minimum": 0
        },
        "C_clipped": {
          "type": "integer",
          "minimum": 0
        },
        "E_committed": {
          "type": "integer",
          "minimum": 1
        },
        "U_unarmed": {
          "type": "integer",
          "minimum": 0
        },
        "closure_holds": {
          "const": true
        },
        "draft_subset_holds": {
          "const": true
        },
        "equal_work_holds": {
          "const": true
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_decode_time_s",
        "source"
      ],
      "properties": {
        "request_decode_time_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source": {
          "const": "sum_same_scheduler_event_request_decode_time"
        }
      }
    },
    "estimands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decode_rate_req",
        "tau_raw"
      ],
      "properties": {
        "decode_rate_req": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tau_raw": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "action_id": {
      "enum": [
        "off",
        "target-matching-k4",
        "target-matching-w512-masked-k4"
      ]
    }
  }
}
