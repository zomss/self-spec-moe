{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-spec.local/phase97/p4_b0_full_prefill_resource_repair_probe.schema.json",
  "title": "Phase 97 B0 full-prefill resource-repair probe authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "date",
    "status",
    "source_artifacts",
    "probe_contract",
    "memory_repair",
    "serving_chunked_prefill_boundary",
    "decision",
    "claims",
    "authorizations",
    "execution_policy",
    "next_artifact"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "package_id": {
      "const": "p4-b0-full-prefill-resource-repair-probe-v2"
    },
    "date": { "type": "string", "format": "date" },
    "status": { "const": "authorized_gpu4_memory_repair_probe_only" },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_authorization",
        "prior_probe_authorization",
        "prior_probe_result",
        "matrix_runner",
        "runner_tests",
        "base_probe_script",
        "repair_probe_script",
        "repair_probe_tests",
        "repair_probe_schema"
      ],
      "properties": {
        "base_authorization": { "$ref": "#/$defs/artifact_ref" },
        "prior_probe_authorization": { "$ref": "#/$defs/artifact_ref" },
        "prior_probe_result": { "$ref": "#/$defs/artifact_ref" },
        "matrix_runner": { "$ref": "#/$defs/artifact_ref" },
        "runner_tests": { "$ref": "#/$defs/artifact_ref" },
        "base_probe_script": { "$ref": "#/$defs/artifact_ref" },
        "repair_probe_script": { "$ref": "#/$defs/artifact_ref" },
        "repair_probe_tests": { "$ref": "#/$defs/artifact_ref" },
        "repair_probe_schema": { "$ref": "#/$defs/artifact_ref" }
      }
    },
    "probe_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_gpu_index",
        "gpu_uuid",
        "model_revision",
        "max_num_batched_tokens",
        "chunked_prefill_enabled",
        "gpu_memory_utilization",
        "speculative_slot_reserve",
        "effective_scheduler_token_budget",
        "max_microbatch_prompt_tokens",
        "minimum_shared_kv_blocks",
        "invocation"
      ],
      "properties": {
        "physical_gpu_index": { "const": 4 },
        "gpu_uuid": {
          "const": "GPU-c9d19019-5065-2353-80a9-f1797eb19d51"
        },
        "model_revision": {
          "const": "b968826d9c46dd6066d109eabc6255188de91218"
        },
        "max_num_batched_tokens": { "const": 114688 },
        "chunked_prefill_enabled": { "const": true },
        "gpu_memory_utilization": { "const": 0.96 },
        "speculative_slot_reserve": { "const": 32 },
        "effective_scheduler_token_budget": { "const": 114656 },
        "max_microbatch_prompt_tokens": { "const": 112908 },
        "minimum_shared_kv_blocks": { "const": 21682 },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argv", "output", "create_new_output"],
          "properties": {
            "argv": {
              "type": "array",
              "prefixItems": [
                { "const": ".venv/bin/python" },
                {
                  "const": "research/97_composition_runtime/scripts/probe_p4_b0_full_prefill_resource_repair.py"
                },
                { "const": "--authorization" },
                {
                  "const": "research/97_composition_runtime/data/p4/p4_b0_full_prefill_resource_repair_probe_authorization.json"
                },
                { "const": "--output" },
                {
                  "const": "research/97_composition_runtime/data/p4/p4_b0_full_prefill_resource_repair_probe.json"
                }
              ],
              "minItems": 6,
              "maxItems": 6
            },
            "output": {
              "const": "research/97_composition_runtime/data/p4/p4_b0_full_prefill_resource_repair_probe.json"
            },
            "create_new_output": { "const": true }
          }
        }
      }
    },
    "memory_repair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_engine_field",
        "prior_value",
        "probe_value",
        "all_other_engine_fields_unchanged",
        "prior_num_gpu_blocks",
        "required_additional_blocks",
        "projected_num_gpu_blocks",
        "projection_is_authority"
      ],
      "properties": {
        "changed_engine_field": { "const": "gpu_memory_utilization" },
        "prior_value": { "const": 0.9 },
        "probe_value": { "const": 0.96 },
        "all_other_engine_fields_unchanged": { "const": true },
        "prior_num_gpu_blocks": { "const": 19928 },
        "required_additional_blocks": { "const": 1754 },
        "projected_num_gpu_blocks": { "const": 22102 },
        "projection_is_authority": { "const": false }
      }
    },
    "serving_chunked_prefill_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "max_num_batched_tokens",
        "chunked_prefill_enabled",
        "gpu_memory_utilization",
        "measurement_override_is_serving_default",
        "mixed_prefill_decode_diagnosis_required"
      ],
      "properties": {
        "scope": { "const": "post_measurement_real_serving_diagnosis" },
        "max_num_batched_tokens": { "const": 8192 },
        "chunked_prefill_enabled": { "const": true },
        "gpu_memory_utilization": { "const": 0.9 },
        "measurement_override_is_serving_default": { "const": false },
        "mixed_prefill_decode_diagnosis_required": { "const": true }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "scope", "invalidated_by"],
      "properties": {
        "state": { "const": "approve" },
        "scope": { "const": "gpu4_full_prefill_memory_repair_probe_only" },
        "invalidated_by": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_screen_run_ready",
        "resource_capacity_measured",
        "serving_configuration_validated",
        "action_admitted",
        "performance_claim_allowed"
      ],
      "properties": {
        "full_screen_run_ready": { "const": false },
        "resource_capacity_measured": { "const": false },
        "serving_configuration_validated": { "const": false },
        "action_admitted": { "const": false },
        "performance_claim_allowed": { "const": false }
      }
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpu_resource_probe",
        "gpu_value_screen",
        "serving_diagnosis",
        "p4a_engineering",
        "action_admission"
      ],
      "properties": {
        "gpu_resource_probe": { "const": true },
        "gpu_value_screen": { "const": false },
        "serving_diagnosis": { "const": false },
        "p4a_engineering": { "const": false },
        "action_admission": { "const": false }
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fallback_gpu_authorized",
        "model_initializations",
        "requests_executed",
        "create_new_output_required",
        "partial_resume_allowed",
        "on_any_failure"
      ],
      "properties": {
        "fallback_gpu_authorized": { "const": false },
        "model_initializations": { "const": 1 },
        "requests_executed": { "const": 0 },
        "create_new_output_required": { "const": true },
        "partial_resume_allowed": { "const": false },
        "on_any_failure": {
          "const": "stop_and_require_fresh_resource_probe_authorization"
        }
      }
    },
    "next_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "passing_result_may_support_v5_review",
        "authorizes_v5"
      ],
      "properties": {
        "kind": {
          "const": "p4_b0_full_prefill_resource_repair_probe_result"
        },
        "passing_result_may_support_v5_review": { "const": true },
        "authorizes_v5": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
