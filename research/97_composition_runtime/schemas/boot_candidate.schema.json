{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-spec.local/phase97/boot_candidate.schema.json",
  "title": "Phase 97 boot resource candidate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "capability_class",
    "fixed_environment_id",
    "shared_kv",
    "resident_objects",
    "evidence",
    "resource_terms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_id": {
      "$ref": "#/$defs/identifier"
    },
    "capability_class": {
      "enum": [
        "B0",
        "B1"
      ]
    },
    "fixed_environment_id": {
      "$ref": "#/$defs/identifier"
    },
    "shared_kv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "owner",
        "pool_count"
      ],
      "properties": {
        "path": {
          "const": "shared_target"
        },
        "owner": {
          "const": "target"
        },
        "pool_count": {
          "const": 1
        }
      }
    },
    "resident_objects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_weight_paths",
        "graph_ids"
      ],
      "properties": {
        "draft_weight_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/weight_path"
          },
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "target_matching"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        "graph_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "candidate_realization_match",
        "source_artifacts",
        "capacity"
      ],
      "properties": {
        "grade": {
          "enum": [
            "measured_exact",
            "static_proxy_projection"
          ]
        },
        "candidate_realization_match": {
          "type": "boolean"
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "measurement_relation",
            "usable_hbm_bytes",
            "sampled_peak_hbm_bytes",
            "available_shared_target_kv_blocks",
            "kv_block_size_tokens",
            "kv_bytes_per_block"
          ],
          "properties": {
            "measurement_relation": {
              "enum": [
                "exact_candidate",
                "optimistic_proxy_ceiling"
              ]
            },
            "usable_hbm_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sampled_peak_hbm_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "available_shared_target_kv_blocks": {
              "type": "integer",
              "minimum": 1
            },
            "kv_block_size_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "kv_bytes_per_block": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "resource_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "co_resident_weight_hbm_bytes",
        "co_resident_graphs_and_workspaces_hbm_bytes",
        "weight_refresh_peak_hbm_bytes",
        "weight_refresh_pinned_host_bytes"
      ],
      "properties": {
        "co_resident_weight_hbm_bytes": {
          "$ref": "#/$defs/hbm_quantity"
        },
        "co_resident_graphs_and_workspaces_hbm_bytes": {
          "$ref": "#/$defs/hbm_quantity"
        },
        "weight_refresh_peak_hbm_bytes": {
          "$ref": "#/$defs/hbm_quantity"
        },
        "weight_refresh_pinned_host_bytes": {
          "$ref": "#/$defs/quantity"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capability_class": {
            "const": "B0"
          }
        },
        "required": [
          "capability_class"
        ]
      },
      "then": {
        "properties": {
          "resident_objects": {
            "properties": {
              "draft_weight_paths": {
                "maxItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capability_class": {
            "const": "B1"
          }
        },
        "required": [
          "capability_class"
        ]
      },
      "then": {
        "properties": {
          "resident_objects": {
            "properties": {
              "draft_weight_paths": {
                "minItems": 2,
                "maxItems": 2,
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "quantized"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "type": "object",
            "properties": {
              "grade": {
                "const": "measured_exact"
              }
            },
            "required": [
              "grade"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "candidate_realization_match": {
                "const": true
              },
              "capacity": {
                "properties": {
                  "measurement_relation": {
                    "const": "exact_candidate"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "type": "object",
            "properties": {
              "grade": {
                "const": "static_proxy_projection"
              }
            },
            "required": [
              "grade"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "candidate_realization_match": {
                "const": false
              },
              "capacity": {
                "properties": {
                  "measurement_relation": {
                    "const": "optimistic_proxy_ceiling"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "weight_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_id",
        "kind"
      ],
      "properties": {
        "path_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "target_matching",
            "quantized"
          ]
        }
      }
    },
    "quantity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value_bytes",
            "grade",
            "source"
          ],
          "properties": {
            "value_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "grade": {
              "enum": [
                "measured",
                "conservative_upper_bound"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value_bytes",
            "grade",
            "source"
          ],
          "properties": {
            "value_bytes": {
              "const": 0
            },
            "grade": {
              "const": "not_applicable"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value_bytes",
            "grade",
            "source"
          ],
          "properties": {
            "value_bytes": {
              "type": "null"
            },
            "grade": {
              "const": "unknown"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "hbm_quantity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value_bytes",
            "grade",
            "source",
            "included_in_capacity_evidence"
          ],
          "properties": {
            "value_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "grade": {
              "enum": [
                "measured",
                "conservative_upper_bound"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "included_in_capacity_evidence": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value_bytes",
            "grade",
            "source",
            "included_in_capacity_evidence"
          ],
          "properties": {
            "value_bytes": {
              "const": 0
            },
            "grade": {
              "const": "not_applicable"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "included_in_capacity_evidence": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value_bytes",
            "grade",
            "source",
            "included_in_capacity_evidence"
          ],
          "properties": {
            "value_bytes": {
              "type": "null"
            },
            "grade": {
              "const": "unknown"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "included_in_capacity_evidence": {
              "const": false
            }
          }
        }
      ]
    }
  }
}
